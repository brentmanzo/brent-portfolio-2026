{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/portfolio-content.schema.json",
  "title": "Engineer Portfolio Content",
  "description": "Build-time JSON content for the single-page engineer portfolio.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile",
    "projects",
    "experience",
    "certifications",
    "contact"
  ],
  "properties": {
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "tagline", "bio"],
      "dependentRequired": {
        "portraitImage": ["portraitAlt"],
        "portraitAlt": ["portraitImage"]
      },
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "tagline": { "type": "string", "minLength": 1 },
        "bio": { "type": "string", "minLength": 1 },
        "portraitImage": {
          "type": "string",
          "minLength": 1,
          "pattern": "^/images/"
        },
        "portraitAlt": { "type": "string", "minLength": 1 }
      }
    },
    "projects": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "description", "liveUrl"],
        "dependentRequired": {
          "previewImage": ["previewAlt"],
          "previewAlt": ["previewImage"]
        },
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "githubUrl": {
            "anyOf": [
              { "type": "string", "const": "" },
              {
                "type": "string",
                "format": "uri",
                "pattern": "^https://github\\.com/"
              }
            ]
          },
          "liveUrl": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          },
          "previewImage": {
            "type": "string",
            "minLength": 1,
            "pattern": "^/images/"
          },
          "previewAlt": { "type": "string", "minLength": 1 }
        }
      }
    },
    "experience": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "employer",
          "title",
          "location",
          "startDate",
          "endDate",
          "description"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "employer": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "location": { "type": "string", "minLength": 1 },
          "startDate": {
            "type": "string",
            "pattern": "^\\d{4}-(0[1-9]|1[0-2])$"
          },
          "endDate": {
            "oneOf": [
              {
                "type": "string",
                "pattern": "^\\d{4}-(0[1-9]|1[0-2])$"
              },
              { "type": "null" }
            ]
          },
          "description": { "type": "string", "minLength": 1 }
        }
      }
    },
    "certifications": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "issuer", "date"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "issuer": { "type": "string", "minLength": 1 },
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-(0[1-9]|1[0-2])$"
          },
          "credentialUrl": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          }
        }
      }
    },
    "contact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["email"],
      "properties": {
        "email": { "type": "string", "format": "email", "minLength": 1 }
      }
    }
  }
}
